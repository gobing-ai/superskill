{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
    "name": "cc",
    "version": "0.3.34",
    "description": "Superskill CLI workflows for agent skills and coding-agent configuration.",
    "author": {
        "name": "Gobing AI",
        "email": "support@gobing.ai",
        "url": "https://gobing.ai/"
    },
    "homepage": "https://gobing.ai/prod-superskill",
    "repository": "https://github.com/gobing-ai/superskill",
    "license": "Apache-2.0",
    "keywords": ["agent-skills", "codex", "developer-tools", "superskill"],
    "extensions": {
        "pi": ["scripts/anti-hallucination/pi-stop.ts"],
        "com.openai": {
            "interface": {
                "displayName": "Superskill",
                "shortDescription": "Author skills with Superskill",
                "longDescription": "Use the Superskill CLI in a local Codex project to create, validate, evaluate, refine, and evolve agent skills, commands, subagents, hooks, and main-agent configurations. Bundled skills guide those workflows and OpenAI plugin publication. Bun and the Superskill CLI are separate local prerequisites.",
                "developerName": "Gobing AI",
                "category": "Developer Tools",
                "capabilities": [
                    "Author agent skills",
                    "Review agent configurations",
                    "Distribute coding-agent workflows"
                ],
                "websiteURL": "https://gobing.ai/prod-superskill",
                "supportURL": "https://gobing.ai/#contact",
                "privacyPolicyURL": "https://gobing.ai/privacy",
                "termsOfServiceURL": "https://gobing.ai/terms",
                "defaultPrompt": [
                    "Create and validate a new agent skill with Superskill.",
                    "Review this agent skill and suggest specific improvements.",
                    "Review a coding-agent hook with Superskill."
                ],
                "logo": "./assets/superskill-logo.svg",
                "composerIcon": "./assets/superskill-logo.svg"
            },
            "review": {
                "commerce": false
            },
            "publication": {
                "countries": []
            }
        }
    }
}
